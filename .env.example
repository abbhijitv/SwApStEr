AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
DATABASE_URL=sqlite:///./campusswap.db
# Future PostgreSQL (server-side only; leave SQLite above for local development):
# DATABASE_URL=postgresql+psycopg://USER:PERCENT_ENCODED_PASSWORD@HOST:5432/postgres?sslmode=require
# Plain postgresql:// and postgres:// URLs also select Psycopg 3.
# PostgreSQL startup never creates tables, seeds demo data, or imports SQLite data.
# See docs/POSTGRESQL.md before explicitly running any Alembic command.
MAX_NEGOTIATION_TURNS=8
APP_ENV=development
ENABLE_JUDGE_MODE=false
